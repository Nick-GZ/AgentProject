# 复制为 .env 后修改
# JWT 签名密钥（生产环境务必更换为随机长字符串）
SECRET_KEY=please-change-me-to-a-long-random-string

# 数据库连接串（默认 SQLite；生产可换 PostgreSQL，如：
# postgresql+psycopg2://user:pass@localhost:5432/aicourse）
DATABASE_URL=sqlite:///./aicourse.db

# JWT 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS 允许的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 大模型配置：不填 ANTHROPIC_API_KEY 时系统自动降级为“模拟模式”
# （仍可完整体验出题/批阅流程，但内容由内置模板生成）
ANTHROPIC_API_KEY=
# 模型名（官方 API 用 claude-sonnet-4-5；百炼用 qwen3.7-plus 等）
LLM_MODEL=claude-sonnet-4-5
# Anthropic 协议兼容端点（留空 = 官方 Anthropic API）
# 阿里云百炼（DashScope）：https://dashscope.aliyuncs.com/apps/anthropic（配合 LLM_MODEL=qwen3.7-plus）
# 智谱 BigModel：https://open.bigmodel.cn/api/anthropic（配合 LLM_MODEL=glm-4.6 等）
LLM_BASE_URL=
